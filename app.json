{
  "expo": {
    "name": "WeWant",
    "slug": "wewant-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "scheme": "wewant",
    "splash": {
      "backgroundColor": "#ffffff"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.wewant.app"
    },
    "android": {
      "package": "com.wewant.app"
    },
    "plugins": [
      "expo-notifications",
      "expo-web-browser",
      [
        "@sentry/react-native/expo",
        {
          "url": "https://sentry.io/",
          "project": "javascript-react",
          "organization": "wewant"
        }
      ]
    ]
  }
}
